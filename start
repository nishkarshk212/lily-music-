#!/usr/bin/env bash
# PYTHONPATH=/app guarantees that Python finds /app/ishu BEFORE
# anything installed in .venv/lib/.../site-packages.
export PYTHONPATH=/app:${PYTHONPATH}

mkdir -p /app/bin
export PATH="/app/bin:$HOME/.deno/bin:$PATH"

# Ensure ffmpeg is available
if ! command -v ffmpeg &>/dev/null; then
    if [ ! -f "/app/bin/ffmpeg" ]; then
        echo "ffmpeg missing from PATH, downloading static binary..."
        curl -sL https://mm.jqu.de/ffmpeg-official-static/ffmpeg-release-amd64-static.tar.xz | tar -xJ --strip-components=1 -C /app/bin --wildcards '*ffmpeg' 2>/dev/null || true
        chmod +x /app/bin/ffmpeg 2>/dev/null || true
    fi
fi

# Ensure deno is available
if ! command -v deno &>/dev/null; then
    if [ ! -f "/app/bin/deno" ]; then
        echo "deno missing from PATH, downloading binary..."
        curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/app/.deno sh &>/dev/null || true
        if [ -f "/app/.deno/bin/deno" ]; then
            cp /app/.deno/bin/deno /app/bin/deno 2>/dev/null || true
            chmod +x /app/bin/deno 2>/dev/null || true
        fi
    fi
fi

# Belt-and-suspenders: clean up any legacy shadow packages in site-packages
find /app/.venv/lib -maxdepth 4 -type d -name "ishu" 2>/dev/null \
  | grep site-packages | xargs rm -rf 2>/dev/null || true
find /app/.venv/lib -maxdepth 4 -name "lily_3_0*" 2>/dev/null \
  | xargs rm -rf 2>/dev/null || true
find /app/.venv/lib -maxdepth 4 -name "anonxmusic*" 2>/dev/null \
  | xargs rm -rf 2>/dev/null || true

if [ -f "/app/.venv/bin/python3" ]; then
    exec /app/.venv/bin/python3 -m ishu
else
    exec python3 -m ishu
fi
